{
  "name": "tcs-engine",
  "version": "0.2.0",
  "description": "TCS Engine — modular 2D/3D game engine by The Choco Studios",
  "type": "module",
  "private": true,
  "main": "./dist/tcs-engine.umd.js",
  "module": "./dist/tcs-engine.es.js",
  "exports": {
    ".": {
      "import": "./dist/tcs-engine.es.js",
      "require": "./dist/tcs-engine.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:frekuensi": "vite --config games/frekuensi-0317/vite.config.js",
    "build:frekuensi": "vite build --config games/frekuensi-0317/vite.config.js",
    "preview:frekuensi": "vite preview --config games/frekuensi-0317/vite.config.js",
    "test:engine": "node --test tests/engine/*.test.js",
    "test": "npm run test:engine"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "three": "^0.160.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
